# ---------- data / learning window ----------
DATA_DIR=data
RETENTION_DAYS=28            # keep only the last 4 weeks
DATA_SOURCE=auto             # auto = OpenAlgo, else free Yahoo (^BSESN 5m + ^INDIAVIX)

# ---------- instrument ----------
UNDERLYING=SENSEX
INDEX_EXCHANGE=BSE_INDEX
OPTIONS_EXCHANGE=BFO
STRIKE_STEP=100
LOT_SIZE=20                  # check the current SENSEX lot size
EXPIRY_WEEKDAY=3             # 3 = Thursday. OpenAlgo's expiry list overrides this when reachable
HOLIDAYS=2026-11-24,2026-12-25

# ---------- analysis ----------
SWING_POINTS=150             # a reversal this big = a trend shift
MOVE_POINTS=60               # a move smaller than this inside HORIZON_MIN = chop
HORIZON_MIN=60
IV_MULT_D0=1.15              # ATM IV vs India VIX, used only for modelled premiums
IV_MULT_D1=1.05

# ---------- live trigger ----------
TRADE_DAYS=D0,D1
OPENING_RANGE_MIN=15
ENTRY_START=09:35
ENTRY_END=14:30
EXIT_TIME=15:10
MIN_PROB=0.55                # only used when the model passed its walk-forward check
MAX_TRADES_PER_DAY=2
LOTS=1
OPTION_OFFSET=ATM            # ATM, OTM1, ITM1 ...
POLL_SECONDS=30

# ---------- OpenAlgo + hook ----------
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=your-openalgo-api-key
STRATEGY_NAME=sensex_expiry_lab
PRODUCT=MIS
HOOK_HOST=127.0.0.1
HOOK_PORT=8787
HOOK_TOKEN=change-me-to-a-long-random-string
HOOK_URL=http://127.0.0.1:8787/hook
MAX_LOTS=2
DRY_RUN=true                 # set false ONLY when you want real orders
