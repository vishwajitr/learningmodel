# --- Claude (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_ENABLED=true
REQUIRE_CLAUDE_AGREEMENT=true

# --- Telegram (@BotFather → token; send your bot a message, then
#     https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_DRY_RUN=false

# --- OpenAlgo ---
OPENALGO_API_KEY=your-openalgo-key
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765

# --- Instrument (real expiry dates come from OpenAlgo; weekday is the fallback) ---
UNDERLYING=SENSEX
INDEX_EXCHANGE=BSE_INDEX
OPTIONS_EXCHANGE=BFO
LOT_SIZE=20
LOTS=1
EXPIRY_WEEKDAY=3
HOLIDAYS=2026-11-24,2026-12-25

# --- Strategy (index points) ---
INTERVAL=5m
DECISION_TIMES=09:45,10:15,10:45,11:30,12:30,13:30
EXIT_TIME=15:15
TARGET_POINTS_D0=200
STOP_POINTS_D0=120
TARGET_POINTS_D1=250
STOP_POINTS_D1=150
MAX_ALERTS_PER_DAY=2
SEND_SKIP_ALERTS=false

# --- Model ---
MIN_CONFIDENCE=0.55
BUCKET_WEIGHT=3.0
HISTORY_DAYS=365
