# ---------------------------------------------------------------------------
# AI Influencer Studio – environment configuration
# Copy to .env (in this folder) and adjust. Secrets stay on the server only;
# nothing in this file is ever sent to the browser.
# ---------------------------------------------------------------------------

# API server
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Where the SQLite database and generated media are stored (relative to this folder)
DATA_DIR=data
# Number of generation jobs that run in parallel
JOB_CONCURRENCY=1

# ---------------- Language model (scripts, screenplays, captions) ----------
# auto | anthropic | ollama | template-demo
LLM_PROVIDER=auto
# Option A – Claude via the Anthropic API (paid, best Hindi/Marathi quality)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Option B – Ollama (free, local): https://ollama.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ---------------- Image generation -----------------------------------------
# auto | automatic1111 | placeholder
IMAGE_PROVIDER=auto
# Stable Diffusion WebUI (AUTOMATIC1111 / Forge) started with --api
A1111_URL=http://127.0.0.1:7860
A1111_STEPS=28

# ---------------- Voice & animation (Python AI service) --------------------
# auto | indicf5 | mms | espeak
TTS_PROVIDER=auto
# auto | musetalk | sadtalker | wav2lip | liveportrait
ANIMATION_PROVIDER=auto
AI_SERVICE_URL=http://127.0.0.1:8001
ESPEAK_PATH=espeak-ng

# ---------------- Video -----------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Font used for burned-in subtitles (must support Devanagari for Hindi/Marathi)
SUBTITLE_FONT=Noto Sans Devanagari
