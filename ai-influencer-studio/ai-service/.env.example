# Paths to locally cloned animation engines (leave empty if not installed)
MUSETALK_DIR=
MUSETALK_VERSION=v15
SADTALKER_DIR=
WAV2LIP_DIR=
WAV2LIP_CHECKPOINT=checkpoints/wav2lip_gan.pth
LIVEPORTRAIT_DIR=
LIVEPORTRAIT_DRIVING_VIDEO=

# Optional: python interpreter per engine (each engine often needs its own venv)
# SADTALKER_PYTHON=/path/to/SadTalker/.venv/bin/python

# Optional: fully custom command per engine. Placeholders: {python} {dir} {image} {audio} {output} {workdir} {driving}
# If {output} is not used, the newest .mp4 in {workdir} is collected.
# WAV2LIP_CMD={python} inference.py --checkpoint_path checkpoints/wav2lip.pth --face {image} --audio {audio} --outfile {output}
